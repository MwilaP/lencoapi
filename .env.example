# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Lenco Payment Gateway
LENCO_PUBLIC_KEY=your_lenco_public_key
LENCO_SECRET_KEY=your_lenco_secret_key
LENCO_API_BASE_URL=https://api.lenco.co/access/v2
LENCO_SANDBOX_API_BASE_URL=https://api.sandbox.lenco.co/access/v2

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret

# Payment Configuration
SUBSCRIPTION_AMOUNT=100.00
CONTACT_UNLOCK_AMOUNT=30.00
REFERRAL_ACCESS_AMOUNT=30.00
DEFAULT_CURRENCY=ZMW

# Booking Configuration
BOOKING_PAYMENT_EXPIRY_MINUTES=15
BOOKING_COMMITMENT_PERCENTAGE=35
BOOKING_CANCELLATION_DEADLINE_HOURS=24
PLATFORM_COMMISSION_PERCENTAGE=10

# Africa's Talking SMS Configuration
AFRICASTALKING_USERNAME=your_africastalking_username
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_SENDER_ID=your_sender_id
